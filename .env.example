# Optional: enable the AI-written summary on top of the rule engine.
# Copy this file to `.env.local` and fill in the key. Without a key the app
# still works and shows the deterministic, rule-based summary.

# Required to enable AI features.
OPENAI_API_KEY=

# OpenAI-compatible base URL. Works with OpenRouter, Azure gateways,
# Ollama (http://localhost:11434/v1), LM Studio, etc.
# Defaults to https://api.openai.com/v1 when omitted.
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model to call. Defaults to gpt-4o-mini when omitted.
OPENAI_MODEL=gpt-4o-mini

# Model request timeout in milliseconds. Defaults to 30000 when omitted.
AI_TIMEOUT_MS=30000
